{
  "name": "feedsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-site product feed manager: crawls storefronts without a feed export, tracks stock and price changes, and publishes Meta catalog feeds plus Batch API updates.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:routes": "node scripts/audit-routes.ts",
    "db:migrate:local": "wrangler d1 migrations apply feedsmith --local",
    "deploy": "wrangler deploy",
    "test:gtm": "node test/gtm.e2e.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.8",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.18"
  }
}
